{
  "extends": "@boilerplate/tsconfig/nextjs.json",
  "compilerOptions": {
    "paths": {
      "@/*": ["src/*"],
      "@boilerplate/ui": ["../../packages/ui/src"],
      "@boilerplate/config": ["../../packages/config/src"],
      "@boilerplate/db": ["../../packages/db/src"],
      "@boilerplate/utils": ["../../packages/utils/src"]
    },
    "plugins": [{ "name": "next" }]
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules"]
}