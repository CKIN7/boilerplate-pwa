    "eslint": "^8.57.0",
    "drizzle-kit": "^0.20.0",
    "@drizzle-team/studio": "^0.0.5",
    "vitest": "^1.4.0",
    "@vitejs/plugin-react": "^4.2.1",
    "@testing-library/react": "^14.2.0",
    "@testing-library/jest-dom": "^6.4.0",
    "jsdom": "^24.0.0",
    "playwright": "^1.42.0",
    "@playwright/test": "^1.42.0"
