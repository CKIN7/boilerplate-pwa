    "zustand": "^4.5.0",
    "next-intl": "^3.10.0",
    "clsx": "^2.1.0",
    "tailwind-merge": "^2.2.0",
    "lucide-react": "^0.344.0",
    "better-auth": "^0.1.0",
    "next-pwa": "^5.6.0",
    "@boilerplate/ui": "workspace:*",
    "@boilerplate/config": "workspace:*",
    "@boilerplate/db": "workspace:*",
    "@boilerplate/utils": "workspace:*"
  },
  "devDependencies": {
    "@boilerplate/eslint-config": "workspace:*",
