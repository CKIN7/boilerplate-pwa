{
  "extends": "@boilerplate/tsconfig/node.json",
  "compilerOptions": {
    "outDir": "dist",
    "paths": {
      "@boilerplate/db": ["../../packages/db/src"],
      "@boilerplate/db/*": ["../../packages/db/src/*"],
      "@boilerplate/config": ["../../packages/config/src"],
      "@boilerplate/config/*": ["../../packages/config/src/*"],
      "@boilerplate/utils": ["../../packages/utils/src"],
      "@boilerplate/utils/*": ["../../packages/utils/src/*"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}