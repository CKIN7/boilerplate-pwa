{
  "name": "@boilerplate/api",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "test": "vitest run",
    "test:unit": "vitest run --reporter=verbose",
    "test:watch": "vitest"
  },
  "dependencies": {
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "helmet": "^7.1.0",
    "zod": "^3.22.4",
    "drizzle-orm": "^0.29.0",
    "postgres": "^3.4.3",
    "better-auth": "^0.1.0",
    "jsonwebtoken": "^9.0.2",
    "bcryptjs": "^2.4.3",
    "nodemailer": "^6.9.10",
    "pdfkit": "^0.14.0",
    "cloudinary": "^1.41.0",
    "axios": "^1.6.0",
    "rate-limiter-flexible": "^5.0.0",
    "dotenv": "^16.3.1",
    "stripe": "^14.14.0",
    "mercadopago": "^2.0.0",
    "multer": "^1.4.5-lts.1",
    "web-push": "^3.6.7",
    "@boilerplate/db": "workspace:*",
    "@boilerplate/config": "workspace:*",
    "@boilerplate/utils": "workspace:*"
  },
  "devDependencies": {
    "@boilerplate/eslint-config": "workspace:*",
    "@boilerplate/tsconfig": "workspace:*",
    "@types/node": "^20.11.0",
    "@types/express": "^4.17.21",
    "@types/cors": "^2.8.17",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/bcryptjs": "^2.4.6",
    "@types/nodemailer": "^6.4.14",
    "@types/pdfkit": "^0.13.2",
    "@types/multer": "^1.4.11",
    "typescript": "^5.4.0",
    "eslint": "^8.57.0",
    "tsx": "^4.7.0",
    "drizzle-kit": "^0.20.0",
    "@drizzle-team/studio": "^0.0.5",
    "vitest": "^1.4.0"
  }
}